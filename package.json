{
  "name": "mymc-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "PS2 memory card viewer and manager that runs entirely in the browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
